# CleanAir Companion Environment Configuration
# Copy this file to .env for local development

# Gemini API key for GenAI-powered air quality advice and conversational assistance
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (defaults to gemini-2.5-flash if omitted)
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAQ or Weather/Air Quality API key if custom provider is used
AIR_QUALITY_API_KEY=
